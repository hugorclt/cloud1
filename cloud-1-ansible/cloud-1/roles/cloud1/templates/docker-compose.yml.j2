services:
  mariadb:
    image: {{ cloud1_image_mariadb }}
    container_name: cloud1-mariadb
    restart: unless-stopped
    environment:
      MARIADB_ROOT_PASSWORD: "{{ cloud1_mysql_root_password }}"
      MARIADB_DATABASE: "{{ cloud1_db_name }}"
      MARIADB_USER: "{{ cloud1_db_user }}"
      MARIADB_PASSWORD: "{{ cloud1_mysql_wordpress_password }}"
    volumes:
      - mariadb_data:/var/lib/mysql
    networks:
      - backend
    healthcheck:
      test: ["CMD-SHELL", "healthcheck.sh --connect --innodb_initialized || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 40s

  wordpress:
    image: {{ cloud1_image_wordpress }}
    container_name: cloud1-wordpress
    restart: unless-stopped
    depends_on:
      mariadb:
        condition: service_healthy
    environment:
      WORDPRESS_DB_HOST: mariadb:3306
      WORDPRESS_DB_NAME: "{{ cloud1_db_name }}"
      WORDPRESS_DB_USER: "{{ cloud1_db_user }}"
      WORDPRESS_DB_PASSWORD: "{{ cloud1_mysql_wordpress_password }}"
      WORDPRESS_TABLE_PREFIX: "{{ cloud1_wp_table_prefix }}"
    volumes:
      - wordpress_data:/var/www/html
    networks:
      - backend

  phpmyadmin:
    image: {{ cloud1_image_phpmyadmin }}
    container_name: cloud1-phpmyadmin
    restart: unless-stopped
    depends_on:
      mariadb:
        condition: service_healthy
    environment:
      PMA_HOST: mariadb
      PMA_PORT: 3306
      PMA_USER: "{{ cloud1_db_user }}"
      PMA_PASSWORD: "{{ cloud1_mysql_wordpress_password }}"
      UPLOAD_LIMIT: 128M
    networks:
      - backend

  nginx:
    image: {{ cloud1_image_nginx }}
    container_name: cloud1-nginx
    restart: unless-stopped
    depends_on:
      - wordpress
      - phpmyadmin
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - {{ cloud1_project_dir }}/config/nginx/cloud1.conf:/etc/nginx/conf.d/default.conf:ro
      - {{ cloud1_project_dir }}/certs:/etc/nginx/certs:ro
      - wordpress_data:/var/www/html:ro
    networks:
      - backend
      - public

networks:
  public:
  backend:
    internal: true

volumes:
  mariadb_data:
  wordpress_data:
